[bootstrap]
main_collection = /main/main.collectionc
render = /main/plinko.renderc

[script]
shared_state = 1

[display]
width = 720
height = 1080
window_width = 600
window_height = 900
high_dpi = 1
vsync = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = fit

[project]
title = PlinkoHG
version = 1.0

[input]
game_binding = /input/game.input_bindingc

[render]
max_debug_vertices = 65536

[sound]
max_sound_instances = 64
