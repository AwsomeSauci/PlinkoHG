#version 140
in highp vec4 position;
in mediump vec2 texcoord0;
in lowp vec4 ball_color;
out mediump vec2 var_uv;
out lowp vec4 var_color;
uniform vs_uniforms {
    highp mat4 mtx_worldview_proj;
};
void main() {
    gl_Position = mtx_worldview_proj * vec4(position.xyz, 1.0);
    var_uv = texcoord0;
    var_color = ball_color;
}
