local Plinko = require "scripts.bootstrap.plinko"
local Presenter = require "scripts.presentation.game_presenter"
local Hud = require "scripts.ui.hud"
local Widgets = require "scripts.ui.widgets"
local Strings = require "scripts.ui.strings"

local pointerAction = hash("touch")
local intents = {
    [hash("drop_one")] = "Drop", [hash("drop_batch")] = "Batch", [hash("grant")] = "Grant",
    [hash("toggle_stats")] = "Stats", [hash("toggle_sound")] = "Sound", [hash("dismiss")] = "Close",
}

local function onWindowEvent(self, event)
    if not self.presenter then return end
    if event == window.WINDOW_EVENT_FOCUS_LOST then Presenter.SetFocus(self.presenter, false)
    elseif event == window.WINDOW_EVENT_FOCUS_GAINED then Presenter.SetFocus(self.presenter, true) end
end

local function disposePresenter(self)
    local presenter = self.presenter
    self.presenter, self.view = nil, nil
    if presenter then
        local ok, err = pcall(Presenter.Dispose, presenter)
        if not ok then print("[Plinko/cleanup] " .. tostring(err)) end
    end
end

function init(self)
    msg.post(".", "acquire_input_focus")
    local ok, err = pcall(function()
        self.presenter, self.view = Plinko.Create(gui.get_node("root"))
        Presenter.Start(self.presenter)
    end)
    if not ok then
        disposePresenter(self)
        print("[Plinko/startup] " .. tostring(err))
        local root = Widgets.Group(gui.get_node("root"), -360, -540)
        Hud.Fatal(root, Strings.New("ru"), err)
        return
    end
    window.set_listener(onWindowEvent)
end

function update(self, dt)
    if self.presenter then Presenter.Update(self.presenter, dt) end
end

function on_input(self, actionId, action)
    if not self.presenter then return false end
    if actionId == pointerAction then
        local intent, consumed = self.view:Pointer(action)
        if intent then Presenter.Activate(self.presenter, intent) end
        return consumed
    end
    local intent = intents[actionId]
    if intent and action.pressed and not action.repeated then return Presenter.Activate(self.presenter, intent) end
    return false
end

function final(self)
    window.set_listener(nil)
    disposePresenter(self)
    msg.post(".", "release_input_focus")
end
